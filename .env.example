# Copy to .env locally. Never commit the real .env file.

PUID=1000
PGID=1000
TZ=Europe/Stockholm

CONFIG_ROOT=/srv/docker
DATA_ROOT=/srv
MEDIA_ROOT=/srv/media

# Management interfaces bind to localhost by default in this example.
LAN_BIND_IP=127.0.0.1

SERVER_HOSTNAME=homeserver
MEDIA_DISK_DEVICE=/dev/sda

VPN_SERVICE_PROVIDER=your-provider
VPN_SERVER_REGIONS=your-region
VPN_PORT_FORWARD_ONLY=true
VPN_PORT_FORWARDING=on
OPENVPN_USER=replace-me
OPENVPN_PASSWORD=replace-me

JELLYFIN_DOMAIN=media.example.com
JELLYSEERR_DOMAIN=requests.example.com
